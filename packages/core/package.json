{
  "name": "@room-booking/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "exports": {
    ".": "./src/index.ts",
    "./graphql": "./src/graphql/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "generate:api": "openapi-typescript openapi.yml -o src/api/schema.ts",
    "generate:graphql": "graphql-codegen"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@types/node": "^26.6.4",
    "eslint": "10.11.0",
    "graphql": "^16.14.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
