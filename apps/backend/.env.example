# Copier en .env pour changer la configuration (valeurs par défaut ci-dessous).
# API servie sur http://localhost:8080/api (serveur du contrat)
PORT=8080
DB_HOST=localhost
# 5433 si le port 5432 est déjà pris : lancer aussi la base avec DB_PORT=5433 docker compose up -d db
DB_PORT=5432
DB_USER=resa_user
DB_PASSWORD=resa_password
DB_NAME=resa_db
# Obligatoire en production (le back refuse de démarrer sans)
JWT_SECRET=dev-secret
# Mot de passe de tous les comptes créés par pnpm seed
SEED_PASSWORD=motdepasse
