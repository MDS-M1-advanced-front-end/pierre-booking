---
import type { Room } from '@room-booking/core';
import { formatPrice } from '../utils/formatPrice';
import Icon from './Icon.astro';

interface Props {
  room: Room;
}

const { room } = Astro.props;

const isActive = room.status === 'ACTIVE';
const equipment = room.equipment ?? [];
---

<article class="flex h-full flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
  {room.imageUrl ? (
    <img
      class:list={['aspect-video w-full object-cover', { grayscale: !isActive }]}
      src={room.imageUrl}
      alt=""
      loading="lazy"
    />
  ) : (
    <div
      class:list={[
        'grid aspect-video place-items-center bg-action-subtle text-action',
        'bg-[linear-gradient(135deg,transparent_48%,var(--palette-teal-100)_48%,var(--palette-teal-100)_52%,transparent_52%)]',
        { grayscale: !isActive },
      ]}
      aria-hidden="true"
    >
      <Icon name="building" class="size-10 rounded-full bg-surface p-(--space-2) stroke-[1.5]" />
    </div>
  )}

  <div class="flex flex-1 flex-col gap-(--space-2) p-(--space-4)">
    <h3 class="text-md">{room.name}</h3>

    <p class="flex flex-wrap gap-x-(--space-4) gap-y-(--space-1) text-sm text-text-muted">
      <span class="inline-flex items-center gap-(--space-1)">
        <Icon name="pin" />
        {room.location}
      </span>
      <span class="inline-flex items-center gap-(--space-1)">
        <Icon name="users" />
        {room.capacity} pers. max
      </span>
    </p>

    {equipment.length > 0 && (
      <ul class="flex flex-wrap gap-(--space-1)" aria-label="Équipements">
        {equipment.map((item) => (
          <li class="rounded-sm border border-border bg-bg px-(--space-2) py-0.5 text-xs text-text-muted">
            {item}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-auto flex items-baseline justify-between pt-(--space-2)">
      {!isActive && (
        <span class="inline-flex items-center gap-(--space-1) rounded-full bg-surface-muted px-(--space-2) py-0.5 text-xs leading-base font-bold whitespace-nowrap text-status-cancelled-text before:size-2 before:rounded-full before:bg-current before:content-['']">
          Inactive
        </span>
      )}
      <p class="ml-auto text-lg font-bold">
        {formatPrice(room.pricePerHour)}{' '}
        <small class="text-sm font-regular text-text-muted">/ heure</small>
      </p>
    </div>
  </div>
</article>
