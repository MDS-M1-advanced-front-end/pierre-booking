---
// Équipements de la salle (écran 02), en puces. Rendu serveur uniquement.
interface Props {
  equipment: string[] | undefined;
}

const { equipment = [] } = Astro.props;
---

<section class="flex flex-col gap-(--space-2)" aria-labelledby="equipment-title">
  <h2 id="equipment-title">Équipements</h2>
  {equipment.length > 0 ? (
    <ul class="flex flex-wrap gap-(--space-1)">
      {equipment.map((item) => (
        <li class="rounded-sm border border-border bg-bg px-(--space-2) py-0.5 text-xs text-text-muted">
          {item}
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-text-muted">Aucun équipement renseigné.</p>
  )}
</section>
