---
import Head from '../components/Head.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="fr">
  <Head>
    <title>{`${title} · Quorum`}</title>
  </Head>
  <body>
    <main class="mx-auto max-w-(--size-container) p-(--space-5)">
      <slot />
    </main>
  </body>
</html>
