---
// Administration — tableau de bord : coquille statique, contenu dans l'îlot (session dans le
// navigateur, données en GraphQL).
import Skeleton from '../../components/Skeleton.svelte';
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../partials/admin/AdminNav.astro';
import DashboardPage from '../../partials/admin/DashboardPage.svelte';
---

<Layout
  title="Tableau de bord"
  description="Activité de la plateforme : chiffre d'affaires, réservations, salles et clients."
>
  <div class="mb-(--space-5)">
    <h1>Tableau de bord</h1>
    <p class="mt-(--space-1) text-text-muted">
      Activité de la plateforme : chiffre d'affaires, réservations, salles et clients.
    </p>
  </div>
  <AdminNav current="/admin" />

  <DashboardPage client:only="svelte">
    <div slot="fallback" class="flex flex-col gap-(--space-3)" aria-busy="true">
      <p class="visually-hidden" role="status">
        Chargement…
      </p>
      <Skeleton class="h-10 w-1/2" />
      <Skeleton class="h-24 w-full rounded-lg" />
      <Skeleton class="h-24 w-full rounded-lg" />
    </div>
  </DashboardPage>
</Layout>
