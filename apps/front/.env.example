# Copier en .env pour changer l'URL de l'API.
# Par défaut : le back NestJS (http://localhost:8080/api). Mock Prism : http://localhost:4010
API_BASE_URL=http://localhost:8080/api
# URL vue par le navigateur, si elle diffère de celle du serveur Astro (Docker). Défaut : API_BASE_URL
# PUBLIC_API_BASE_URL=http://localhost:8080/api
