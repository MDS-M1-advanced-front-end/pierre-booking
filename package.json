{
  "name": "room-booking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core:sync": "node scripts/sync-core.js https://github.com/MDS-M1-advanced-front-end/core.git 👨🏻‍🏫pierre",
    "mock": "node mock/build-spec.js && prism mock mock/.generated/openapi.yml --host 0.0.0.0 --port 4010",
    "dev": "node scripts/dev-db.js && pnpm --filter backend migration:run && pnpm --filter \"./apps/*\" --parallel dev",
    "seed": "pnpm --filter backend seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm -r lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stoplight/prism-cli": "5.16.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
