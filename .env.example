# Production (compose.yaml) : copier en .env à la racine.
# Obligatoires : secrets de signature (chaînes longues et aléatoires, >= 16 caractères,
# JWT_REFRESH_SECRET différent de JWT_SECRET, jamais les valeurs de développement).
JWT_SECRET=
JWT_REFRESH_SECRET=
PEPPER_SECRET=
# Mot de passe de la base (obligatoire, sans valeur par défaut en production)
DB_PASSWORD=
# Adresses publiques, si le site n'est pas servi sur localhost
# FRONT_URL=http://localhost:4321
# PUBLIC_API_BASE_URL=http://localhost:8080/api
